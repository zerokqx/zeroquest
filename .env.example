NODE_ENV=development

# Network and app ports
HOST=127.0.0.1
PORT=4200
API_PORT=4000
WALLET_SERVICE_PORT=5103
BACKEND_HOST=${HOST}
BACKEND_PORT=${API_PORT}
WEB_PORT=4200
API_ORIGIN=http://127.0.0.1:4000
REDIS_HOST=127.0.0.1
REDIS_PORT=5102
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:80,http://127.0.0.1:80
SWAGGER_ENABLED=true
ZEROQUEST_LOG_DIR=./logs/zeroquest

# Auth and app secrets
AUTH_JWT_SECRET=change-me-auth-jwt-secret
AUTH_JWT_EXPIRES_IN=30d
APP_DATA_ENCRYPTION_KEY=change-me-app-data-encryption-key
JWT_SECRET=change-me-jwt-secret
JWT_ACCESS_EXPIRE_TIME_MS=1800000
JWT_REFRESH_EXPIRE_TIME_MS=2592000000

# Database and pgAdmin
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5101
POSTGRES_DB=zeroquest
POSTGRES_USER=admin
POSTGRES_PASSWORD=strong_password_here
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
PGADMIN_HOST=127.0.0.1
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=postgres@example.com
PGADMIN_DEFAULT_PASSWORD=strong_password_here

# Nginx and public domain
DOMAIN=example.com
SSL_CERTIFICATE=/etc/nginx/ssl/example.com/fullchain.pem
SSL_CERTIFICATE_KEY=/etc/nginx/ssl/example.com/privkey.key

# 3x-ui integration
THREE_X_UI_SECRET_PATH=replace_with_long_random_secret_path
THREE_X_UI_PROTOCOL=https
THREE_X_UI_HOST=127.0.0.1
THREE_X_UI_PORT=20262
THREE_X_UI_WEB_BASE_PATH=replace_with_panel_web_base_path
THREE_X_UI_USERNAME=replace_with_panel_username
THREE_X_UI_PASSWORD=replace_with_panel_password
THREE_X_UI_TIMEOUT_MS=10000
THREE_X_UI_TLS_INSECURE=false
THREE_X_UI_TLS_SERVER_NAME=

# YooKassa integration
YOOKASSA_API_TOKEN=
YOOKASSA_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_REDIRECT_TO=http://localhost:4200
YOOKASSA_WEBHOOK_PATH=replace_with_long_random_webhook_path
YOOKASSA_WEBHOOK_ALLOWED_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11,77.75.156.35,77.75.154.128/25,2a02:5180::/32
