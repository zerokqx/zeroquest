{
  "name": "@zeroquest/zeroquest",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "pm2:run": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pm2 serve dist 4200 --spa --name zeroquest-client",
          "cwd": "apps/zeroquest"
        },
        "dependsOn": [
          "build"
        ]
      },
      "forward-port:run": {
        "executor": "nx:run-commands",
        "options": {
          "command": "ssh -R zerokqx:80:localhost:4200 serveo.net",
          "cwd": "apps/zeroquest",
          "envFile": ".env"
        }
      },
      "orval:run": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bunx orval",
          "cwd": "apps/zeroquest"
        }
      }
    }
  },
  "dependencies": {
    "@mantine/modals": "^9.1.1",
    "@zeroquest/constants": "workspace:*"
  }
}
